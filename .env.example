# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional privacy-safe product analytics. Empty values keep analytics disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_URL=

# AWS
AWS_REGION=
AGENTPROOF_ENVIRONMENT=development
AGENTPROOF_DAILY_RUN_LIMIT_PER_AGENT=10
AGENTPROOF_FOUNDER_USER_IDS=
AGENTPROOF_DYNAMODB_TABLE=
AGENTPROOF_REPORTS_BUCKET=
AGENTPROOF_VERIFICATION_QUEUE_URL=

# Cognito
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Set these only after Google OAuth is configured in Cognito. The browser button remains hidden otherwise.
COGNITO_DOMAIN=
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# Cloudflare Turnstile. Required for public sign-up and password resets in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
AGENTPROOF_TURNSTILE_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_SECRET_ARN=
OPENAI_MODEL=gpt-4.1-mini

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_CHECKOUT_ENABLED=false
DODO_BUILDER_PRODUCT_ID=
DODO_AGENCY_PRODUCT_ID=
DODO_ONE_RUN_PRODUCT_ID=

# Sarvam, deferred until regional-language expansion
SARVAM_API_KEY=
